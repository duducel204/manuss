# Google Gemini API Key
GEMINI_API_KEY=

# Termux MCP Remote URL (e.g. https://xxxx.trycloudflare.com/mcp)
TERMUX_MCP_URL=

# Termux MCP Bearer Token generated by the Termux MCP server
TERMUX_MCP_TOKEN=

# Optional: stable server-side HMAC key for command approval proposals
# If omitted, GEMINI_API_KEY is used as the signing key.
APPROVAL_SIGNING_KEY=
